# Copy to .env and fill in. Never commit .env.

# LLM provider: groq | ollama | rule_based
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b

# Authentication (use a long random string for JWT_SECRET)
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
JWT_TTL_HOURS=8
# Persona sign-in for the demo; set to false so only email and password sign-in remain.
DEMO_LOGIN_ENABLED=true
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
# Password for the seeded synthetic accounts (see README); change it for any shared deployment.
# SEED_USER_PASSWORD=

# Database: leave unset for SQLite (no Docker). Docker Compose sets its own Postgres URL.
# DATABASE_URL=postgresql+psycopg://countersign:countersign@localhost:5432/countersign

LOG_LEVEL=INFO
