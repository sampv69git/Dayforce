# Copy to .env and fill in. Never commit .env.

# LLM provider: groq | ollama | rule_based
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b

# Demo authentication (use a long random string)
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars

# Database: leave unset for SQLite (no Docker). Docker Compose sets its own Postgres URL.
# DATABASE_URL=postgresql+psycopg://countersign:countersign@localhost:5432/countersign

LOG_LEVEL=INFO
